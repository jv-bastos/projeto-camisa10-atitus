{
  "info": {
    "name": "Camisa 10 – API",
    "description": "Testes manuais da API do Camisa 10.\n\nCOMO USAR:\n1. Suba a API: .\\mvnw spring-boot:run \"-Dspring-boot.run.profiles=dev\"\n2. Rode PRIMEIRO a pasta '1. Autenticação' (os logins salvam os tokens sozinhos).\n3. Depois rode qualquer outra requisição.\n\nCada requisição tem testes automáticos (aba 'Test Results' na resposta).\nO banco do perfil dev é recriado a cada reinício da API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "tokenVendedor", "value": "" },
    { "key": "tokenComprador", "value": "" },
    { "key": "produtoCriadoId", "value": "" },
    { "key": "fotoCatalogo", "value": "" },
    { "key": "pedidoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login VENDEDOR (salva o token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test('Perfil VENDEDOR', () => pm.expect(corpo.usuario.perfil).to.eql('VENDEDOR'));",
                  "pm.test('Não devolve a senha', () => pm.expect(corpo.usuario).to.not.have.property('senhaHash'));",
                  "pm.collectionVariables.set('tokenVendedor', corpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"vendedor@camisa10.com\",\n  \"senha\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login COMPRADOR (salva o token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.test('Perfil COMPRADOR', () => pm.expect(corpo.usuario.perfil).to.eql('COMPRADOR'));",
                  "pm.collectionVariables.set('tokenComprador', corpo.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"comprador@camisa10.com\",\n  \"senha\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login com senha errada → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensagem em português', () => pm.expect(pm.response.json().mensagem).to.eql('E-mail ou senha inválidos.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"comprador@camisa10.com\",\n  \"senha\": \"errada\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Cadastro de novo usuário (RF01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Já devolve token', () => pm.expect(pm.response.json().token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Torcedor Novo\",\n  \"email\": \"{{$randomEmail}}\",\n  \"senha\": \"123456\",\n  \"perfil\": \"COMPRADOR\"\n}" },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "Cadastro com dados inválidos → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lista os erros por campo', () => pm.expect(pm.response.json().campos).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"\",\n  \"email\": \"nao-e-email\",\n  \"senha\": \"123\"\n}" },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        }
      ]
    },
    {
      "name": "2. Catálogo (público, sem token)",
      "item": [
        {
          "name": "Listar categorias",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('10 categorias', () => pm.expect(pm.response.json()).to.have.lengthOf(10));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/categorias" }
        },
        {
          "name": "Listar produtos",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tem produtos', () => pm.expect(pm.response.json().length).to.be.above(0));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/produtos" }
        },
        {
          "name": "Buscar por nome (?busca=barcelona)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Só Barcelona', () => pm.response.json().forEach(p => pm.expect(p.nome.toLowerCase()).to.include('barcelona')));"
          ] } }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/produtos?busca=barcelona", "host": ["{{baseUrl}}"], "path": ["api", "produtos"],
                     "query": [{ "key": "busca", "value": "barcelona" }] }
          }
        },
        {
          "name": "Filtrar por categoria (?categoriaId=7 = Seleções)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Todas estão em Seleções (podem ter outras categorias também)', () => pm.response.json().forEach(p => pm.expect(p.categorias.map(c => c.nome)).to.include('Seleções')));"
          ] } }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/produtos?categoriaId=7", "host": ["{{baseUrl}}"], "path": ["api", "produtos"],
                     "query": [{ "key": "categoriaId", "value": "7" }] }
          }
        },
        {
          "name": "Detalhe do produto 26 (Seleção Brasileira)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tem as cores da camisa', () => { const p = pm.response.json(); pm.expect(p.corPrincipal).to.match(/^#[0-9A-F]{6}$/); pm.expect(p.corTexto).to.match(/^#[0-9A-F]{6}$/); });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/produtos/26" }
        },
        {
          "name": "Vitrine filtrada (amarelas, até R$ 400, 2000–2026, tamanho G, menor preço)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('Só amarelas, dentro da faixa, com G em estoque', () => lista.forEach(p => { pm.expect(p.corFamilia).to.eql('Amarelo'); pm.expect(p.preco).to.be.at.most(400); pm.expect(p.ano).to.be.within(2000, 2026); pm.expect(p.tamanhos.find(t => t.tamanho === 'G').quantidade).to.be.above(0); }));",
                  "pm.test('Ordenadas do menor para o maior preço', () => { for (let i = 1; i < lista.length; i++) pm.expect(lista[i].preco).to.be.at.least(lista[i - 1].preco); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/produtos?cores=Amarelo&precoMax=400&anoMin=2000&anoMax=2026&tamanho=G&ordenar=preco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "produtos"
              ],
              "query": [
                {
                  "key": "cores",
                  "value": "Amarelo"
                },
                {
                  "key": "precoMax",
                  "value": "400"
                },
                {
                  "key": "anoMin",
                  "value": "2000"
                },
                {
                  "key": "anoMax",
                  "value": "2026"
                },
                {
                  "key": "tamanho",
                  "value": "G"
                },
                {
                  "key": "ordenar",
                  "value": "preco"
                }
              ]
            }
          }
        },
        {
          "name": "Opções do painel de filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Traz marcas, cores, tamanhos e 8 ordenações', () => { const o = pm.response.json(); pm.expect(o.marcas).to.include('Nike'); pm.expect(o.tamanhos).to.eql(['P', 'M', 'G', 'GG', 'XGG']); pm.expect(o.ordenacoes.length).to.eql(8); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/produtos/filtros"
          }
        },
        {
          "name": "Configuração da personalização",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Acréscimo R$ 25 e 12 caracteres', () => { const c = pm.response.json(); pm.expect(c.valorAcrescimo).to.eql(25); pm.expect(c.maxCaracteresNome).to.eql(12); });"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/config/personalizacao" }
        }
      ]
    },
    {
      "name": "3. Critérios de aceite",
      "item": [
        {
          "name": "RF15 – Comprador tenta criar produto → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403 (bloqueado no backend)', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Camisa Pirata\",\n  \"ano\": 2026,\n  \"preco\": 10,\n  \"estoques\": { \"M\": 1 },\n  \"categoriaIds\": [1],\n  \"corPrincipal\": \"#000000\",\n  \"corTexto\": \"#FFFFFF\"\n}" },
            "url": "{{baseUrl}}/api/produtos"
          }
        },
        {
          "name": "Sem token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pedidos/meus" }
        },
        {
          "name": "Compra personalizada – total inclui acréscimo",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const pedido = pm.response.json();",
            "pm.collectionVariables.set('pedidoId', pedido.id);",
            "const item1 = pedido.itens[0], item2 = pedido.itens[1];",
            "const esperado = (item1.precoUnitario + 25) * 2 + item2.precoUnitario;",
            "pm.test('Total = (preço + 25) x 2 + preço sem personalização', () => pm.expect(pedido.valorTotal).to.be.closeTo(esperado, 0.001));",
            "pm.test('Nome salvo em MAIÚSCULAS', () => pm.expect(item1.personalizacao.nome).to.eql('RONALDINHO'));",
            "pm.test('Item 2 sem personalização', () => pm.expect(item2.personalizacao).to.eql(null));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itens\": [\n    { \"produtoId\": 26, \"tamanho\": \"M\", \"quantidade\": 2, \"personalizacao\": { \"nome\": \"Ronaldinho\", \"numero\": 10 } },\n    { \"produtoId\": 26, \"tamanho\": \"M\", \"quantidade\": 1 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Nome com 13 caracteres → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('Mensagem clara', () => pm.expect(pm.response.json().mensagem).to.include('12 caracteres'));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itens\": [\n    { \"produtoId\": 2, \"tamanho\": \"M\", \"quantidade\": 1, \"personalizacao\": { \"nome\": \"ABCDEFGHIJKLM\", \"numero\": 10 } }\n  ]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Número 100 → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('Mensagem clara', () => pm.expect(pm.response.json().mensagem).to.include('entre 0 e 99'));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itens\": [\n    { \"produtoId\": 2, \"tamanho\": \"M\", \"quantidade\": 1, \"personalizacao\": { \"nome\": \"FERNANDAO\", \"numero\": 100 } }\n  ]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Mais unidades que o estoque → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "pm.test('Mensagem de estoque', () => pm.expect(pm.response.json().mensagem).to.include('Estoque insuficiente'));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"itens\": [\n    { \"produtoId\": 31, \"tamanho\": \"M\", \"quantidade\": 999 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/pedidos"
          }
        },
        {
          "name": "Histórico do comprador mostra a personalização",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const id = Number(pm.collectionVariables.get('pedidoId'));",
            "const pedido = pm.response.json().find(p => p.id === id);",
            "pm.test('Pedido da compra aparece', () => pm.expect(pedido).to.not.be.undefined);",
            "pm.test('Com RONALDINHO 10', () => { pm.expect(pedido.itens[0].personalizacao.nome).to.eql('RONALDINHO'); pm.expect(pedido.itens[0].personalizacao.numero).to.eql(10); });"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenComprador}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/pedidos/meus"
          }
        },
        {
          "name": "Vendas do vendedor mostram a personalização",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const id = Number(pm.collectionVariables.get('pedidoId'));",
            "const venda = pm.response.json().find(v => v.pedidoId === id);",
            "pm.test('Venda aparece para o vendedor', () => pm.expect(venda).to.not.be.undefined);",
            "pm.test('Com RONALDINHO 10', () => { pm.expect(venda.itens[0].personalizacao.nome).to.eql('RONALDINHO'); pm.expect(venda.itens[0].personalizacao.numero).to.eql(10); });"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenVendedor}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/vendedor/vendas"
          }
        },
        {
          "name": "Vendedor não pode comprar → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenVendedor}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/pedidos/meus"
          }
        }
      ]
    },
