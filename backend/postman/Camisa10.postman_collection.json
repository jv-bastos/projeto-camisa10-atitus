                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/vendedor/fotos-catalogo?busca=brasil 1994",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vendedor",
                "fotos-catalogo"
              ],
              "query": [
                {
                  "key": "busca",
                  "value": "brasil 1994"
                }
              ]
            }
          }
        },
        {
          "name": "Usar foto do catálogo no produto criado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Produto ganhou a foto', () => pm.expect(pm.response.json().imagemUrl.startsWith('/uploads/')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVendedor}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arquivo\": \"{{fotoCatalogo}}\"\n}"
            },
            "url": "{{baseUrl}}/api/produtos/{{produtoCriadoId}}/imagem-catalogo"
          }
        },
        {
          "name": "Editar o produto criado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Preço atualizado', () => pm.expect(pm.response.json().preco).to.eql(249.9));"
          ] } }],
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenVendedor}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Camisa Retrô Brasil 1994\",\n  \"descricao\": \"Réplica da camisa do tetra. PROMOÇÃO!\",\n  \"preco\": 249.90,\n  \"ano\": 1994,\n  \"marca\": \"Umbro\",\n  \"estoques\": { \"P\": 2, \"M\": 4, \"G\": 3, \"GG\": 2, \"XGG\": 1 },\n  \"categoriaIds\": [7, 8],\n  \"corPrincipal\": \"#FFD100\",\n  \"corTexto\": \"#00843D\"\n}" },
            "url": "{{baseUrl}}/api/produtos/{{produtoCriadoId}}"
          }
        },
        {
          "name": "Excluir o produto criado (exclusão lógica)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenVendedor}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/produtos/{{produtoCriadoId}}"
          }
        },
        {
          "name": "Produto excluído some do catálogo → 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/produtos/{{produtoCriadoId}}" }
        }
      ]
    },
    {
      "name": "5. Upload de imagem (manual)",
      "description": "Antes de enviar: aba Body → form-data → na linha 'imagem', clique em 'Select files' e escolha uma foto JPG/PNG/WEBP de até 5 MB.",
      "item": [
        {
          "name": "Enviar foto do produto 2 (Internacional)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Devolve a URL da imagem', () => pm.expect(pm.response.json().imagemUrl).to.match(/^\\/uploads\\//));",
            "console.log('Abra no navegador: ' + pm.collectionVariables.get('baseUrl') + pm.response.json().imagemUrl);"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenVendedor}}", "type": "string" }] },
            "body": { "mode": "formdata", "formdata": [{ "key": "imagem", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/produtos/2/imagem"
          }
        }
      ]
    }
  ]
}
