            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Camisa Retrô Brasil 1994\",\n  \"descricao\": \"Réplica da camisa do tetra.\",\n  \"preco\": 279.90,\n  \"ano\": 1994,\n  \"marca\": \"Umbro\",\n  \"estoques\": { \"P\": 2, \"M\": 4, \"G\": 3, \"GG\": 2, \"XGG\": 1 },\n  \"categoriaIds\": [7, 8],\n  \"corPrincipal\": \"#FFD100\",\n  \"corTexto\": \"#00843D\"\n}" },
            "url": "{{baseUrl}}/api/produtos"
          }
        },
        {
          "name": "Catálogo de fotos (?busca=brasil 1994) – salva a 1ª foto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const fotos = pm.response.json();",
                  "pm.test('Encontrou fotos com nome e categorias sugeridos', () => { pm.expect(fotos.length).to.be.above(0); pm.expect(fotos[0].categorias.length).to.be.above(0); });",
                  "pm.collectionVariables.set('fotoCatalogo', fotos[0].arquivo);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
