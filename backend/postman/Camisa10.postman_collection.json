            "url": "{{baseUrl}}/api/vendedor/produtos"
          }
        },
        {
          "name": "Criar produto (salva o id)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Duas categorias: Seleções e Retrô', () => pm.expect(pm.response.json().categorias.map(c => c.nome)).to.eql(['Seleções', 'Retrô']));",
            "pm.collectionVariables.set('produtoCriadoId', pm.response.json().id);"
          ] } }],
          "request": {
